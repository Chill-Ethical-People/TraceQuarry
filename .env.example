# The default Compose deployment is intentionally reachable only from this host.
TRACEQUARRY_BIND_ADDRESS=127.0.0.1
TRACEQUARRY_PORT=8765

# Use tracequarry:local with `docker compose up --build`, or set a published image.
TRACEQUARRY_IMAGE=tracequarry:local

# Optional read-only evidence directory for server-path ingestion.
TRACEQUARRY_EVIDENCE_DIR=./evidence
